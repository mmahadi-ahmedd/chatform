# Postgres connection string (Supabase: Project Settings > Database > Connection string (pooler))
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to true for Supabase / hosted Postgres that requires SSL
DATABASE_SSL=false
# Long random string used to sign login cookies (openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string

# --- Optional (Task 2) ---
# Comma-separated emails that are promoted to administrator on signup/login
ADMIN_EMAILS=
# Email notifications via https://resend.com (leave empty to disable; deliveries are logged as "skipped")
RESEND_API_KEY=
MAIL_FROM=ChatForm <onboarding@resend.dev>
# Public URL of the app, used for links inside notification emails
APP_URL=
# Separate key for encrypting webhook secrets (defaults to a key derived from AUTH_SECRET)
ENCRYPTION_KEY=
# Local development / tests ONLY. Never set in production (disables the webhook SSRF guard).
ALLOW_PRIVATE_WEBHOOKS=false
